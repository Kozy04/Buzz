{
  "theme": "Nexus Dark Obsidian",
  "version": "1.0.0",
  "colors": {
    "background": {
      "primary": "#08080A",
      "secondary": "#0E0E12",
      "tertiary": "#14141A"
    },
    "surface": {
      "card": "rgba(255, 255, 255, 0.03)",
      "cardHover": "rgba(255, 255, 255, 0.06)",
      "glass": "rgba(14, 14, 18, 0.75)",
      "input": "rgba(255, 255, 255, 0.04)"
    },
    "border": {
      "subtle": "rgba(255, 255, 255, 0.08)",
      "hover": "rgba(255, 255, 255, 0.20)",
      "active": "#00F0FF",
      "glow": "rgba(0, 240, 255, 0.35)"
    },
    "brand": {
      "primary": "#00F0FF",
      "primaryGradient": "linear-gradient(135deg, #00F0FF 0%, #7000FF 100%)",
      "secondary": "#8B5CF6",
      "accent": "#6366F1",
      "success": "#10B981",
      "warning": "#F59E0B",
      "danger": "#EF4444"
    },
    "text": {
      "primary": "#F9FAFB",
      "secondary": "#9CA3AF",
      "muted": "#6B7280",
      "inverse": "#08080A"
    },
    "glows": {
      "heroRadial": "radial-gradient(600px circle at 50% 10%, rgba(112, 0, 255, 0.18), transparent 70%)",
      "cyanSpot": "radial-gradient(400px circle at 30% 20%, rgba(0, 240, 255, 0.12), transparent 60%)",
      "cardHoverGlow": "radial-gradient(300px circle at 50% 50%, rgba(0, 240, 255, 0.10), transparent 70%)"
    }
  },
  "typography": {
    "fontFamilies": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "display": "Plus Jakarta Sans, Inter, sans-serif",
      "code": "'JetBrains Mono', 'Fira Code', Menlo, Monaco, Consolas, monospace"
    },
    "fontSizes": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px",
      "5xl": "48px",
      "6xl": "64px",
      "hero": "72px"
    },
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "lineHeights": {
      "tight": 1.1,
      "snug": 1.25,
      "normal": 1.5,
      "relaxed": 1.65
    }
  },
  "borderRadius": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "shadows": {
    "card": "0 8px 32px 0 rgba(0, 0, 0, 0.37)",
    "glowPrimary": "0 0 30px rgba(0, 240, 255, 0.25)",
    "glowPurple": "0 0 40px rgba(139, 92, 246, 0.20)",
    "innerGlow": "inset 0 1px 1px 0 rgba(255, 255, 255, 0.12)"
  },
  "springs": {
    "snappy": {
      "stiffness": 400,
      "damping": 30
    },
    "gentle": {
      "stiffness": 200,
      "damping": 25
    }
  }
}
